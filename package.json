{
  "name": "@jungherz-de/notionkit",
  "version": "1.15.0",
  "type": "module",
  "description": "A calm, document-centric CSS component library in the Notion idiom – sidebar, page tree, database views, settings and AI surfaces. ~100 components, light & dark mode, no dependencies.",
  "main": "notionkit.css",
  "style": "notionkit.css",
  "files": [
    "notionkit.css",
    "notionkit.min.css",
    "notionkit.min.css.map",
    "notionkit-styles.js",
    "theme-override.css",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SKILL.md"
  ],
  "scripts": {
    "minify": "esbuild notionkit.css --minify --sourcemap --outfile=notionkit.min.css --log-level=warning",
    "build:styles-js": "node build-styles-js.mjs",
    "build:pages": "node tools/build-landing.mjs && node tools/build-pages.mjs",
    "build:skill": "node tools/build-skill.mjs",
    "build:meta": "node tools/build-meta.mjs",
    "build": "npm run minify && npm run build:styles-js && npm run build:pages && npm run build:skill && npm run build:meta",
    "check:coverage": "node tools/check-coverage.mjs",
    "check:versions": "node tools/check-versions.mjs",
    "version": "node tools/sync-version.mjs && git add notionkit.css",
    "prepublishOnly": "npm run build",
    "test": "playwright test",
    "check:size": "node tools/check-size.mjs",
    "check:package": "node tools/check-package.mjs",
    "build:og": "node tools/build-og.mjs"
  },
  "keywords": [
    "css",
    "notion",
    "design-system",
    "workspace",
    "documents",
    "ui",
    "components",
    "design-tokens",
    "dark-mode",
    "light-mode",
    "no-dependencies"
  ],
  "author": "Jungherz GmbH <info@jungherz.com> (https://www.jungherz.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUNGHERZ/NotionKit.git"
  },
  "homepage": "https://notionkit.jungherz.com",
  "bugs": {
    "url": "https://github.com/JUNGHERZ/NotionKit/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "esbuild": "^0.28.2"
  }
}
